# main.py

import os
import numpy as np
import pandas as pd
import torch
from torch import Tensor
from transformers import AutoTokenizer, AutoModel
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
import matplotlib.pyplot as plt
import seaborn as sns
from xgboost import XGBClassifier

# --- Directory Setup ---
os.makedirs("embeddings", exist_ok=True)
os.makedirs("figures", exist_ok=True)

# --- Embedding Function ---
def average_pool(last_hidden_states: Tensor, attention_mask: Tensor) -> Tensor:
    last_hidden = last_hidden_states.masked_fill(~attention_mask[..., None].bool(), 0.0)
    return last_hidden.sum(dim=1) / attention_mask.sum(dim=1)[..., None]

# --- Load Dataset ---
df = pd.read_csv("dataset/ai-ga-dataset.csv").dropna()
df = df.groupby("label").apply(lambda x: x.sample(n=500, random_state=42)).reset_index(drop=True)

abstracts = df["abstract"].tolist()
titles = df["title"].tolist()
labels = df["label"].tolist()

# --- Load Model ---
tokenizer = AutoTokenizer.from_pretrained("thenlper/gte-base")
model = AutoModel.from_pretrained("thenlper/gte-base")
model.eval()

def embed_texts(texts):
    embeddings = []
    for text in texts:
        batch = tokenizer(text, max_length=512, padding=True, truncation=True, return_tensors='pt')
        with torch.no_grad():
            output = model(**batch)
        embedding = average_pool(output.last_hidden_state, batch["attention_mask"])
        embeddings.append(embedding.squeeze().numpy())
    return embeddings

# --- Generate Embeddings ---
abstract_embeddings = embed_texts(abstracts)
title_embeddings = embed_texts(titles)

# --- Feature Engineering: LLM Keywords ---
LLM_KEYWORDS = [
    'significant', 'remarkable', 'comprehensive', 'novel',
    'state-of-the-art', 'cutting-edge', 'groundbreaking', 'outstanding',
    'revolutionary', 'robust', 'extensive', 'pioneering'
]

def count_llm_keywords(text):
    return sum(text.lower().count(word) for word in LLM_KEYWORDS)

keyword_counts = np.array([count_llm_keywords(text) for text in abstracts]).reshape(-1, 1)

# --- Combine Features ---
X_base = np.array([np.concatenate((a, t)) for a, t in zip(abstract_embeddings, title_embeddings)])
X = np.hstack((X_base, keyword_counts))
y = np.array(labels)

# --- Train/Test Split ---
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, stratify=y, random_state=42)
X_train2, X_val, y_train2, y_val = train_test_split(X_train, y_train, test_size=0.2, stratify=y_train, random_state=42)

# --- Train Model (XGBoost) ---
xgb = XGBClassifier(
    n_estimators=500,
    learning_rate=0.05,
    max_depth=4,
    eval_metric='logloss',
    use_label_encoder=False,
    random_state=42
)
xgb.set_params(early_stopping_rounds=10)
xgb.fit(X_train2, y_train2, eval_set=[(X_val, y_val)], verbose=True)

# --- Evaluation ---
def evaluate_model(model, X_test, y_test, model_name="Model"):
    y_pred = model.predict(X_test)
    print(f"\n{model_name} Accuracy: {accuracy_score(y_test, y_pred):.4f}")
    print(classification_report(y_test, y_pred, target_names=["Human", "AI"]))

    cm = confusion_matrix(y_test, y_pred)
    plt.figure(figsize=(6, 5))
    sns.heatmap(cm, annot=True, fmt="d", cmap="Blues",
                xticklabels=["Human", "AI"], yticklabels=["Human", "AI"])
    plt.xlabel("Predicted")
    plt.ylabel("Actual")
    plt.title(f"{model_name} - Confusion Matrix")
    plt.tight_layout()
    plt.savefig(f"figures/{model_name.replace(' ', '_').lower()}_confusion_matrix.png")
    plt.show()

evaluate_model(xgb, X_test, y_test, model_name="XGBoost LLM Keywords")
